<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - motorlink — Taller Mrcanico</title>
    <link href='@Url.Content("~/Content/Site.css")' rel="stylesheet" type="text/css" />
    <link href='@Url.Content("~/Content/bootstrap.min.css")' rel="stylesheet" type="text/css" />
    <script src='@Url.Content("~/Scripts/modernizr-2.6.2.js")'></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>
<body>
    <header>

        <nav class="navbar">
            <h2 class="logo">motorlink</h2>
            <ul>
                <li><a href='@Url.Action("Index", "Home")'>Inicio</a></li>
                <li><a href='@Url.Action("Index", "Home")#agendar'>Agendar</a></li>
                <li><a href='@Url.Action("Index", "Home")#citas'>Citas</a></li>
                <li><a href='@Url.Action("Ordenes", "Home")'>Ordenes</a></li>
                <li><a href='@Url.Action("Inventario", "Home")'>Inventario</a></li>
                <li><a href='@Url.Action("Pagos", "Home")'>Pagos</a></li>

            </ul>
        </nav>
    </header>





    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - MotorLink Taller Mecanico</p>
        </footer>
    </div>
    <script src='@Url.Content("~/Scripts/jquery-1.10.2.min.js")'></script>
    <script src='@Url.Content("~/Scripts/bootstrap.min.js")'></script>
</body>
</html>