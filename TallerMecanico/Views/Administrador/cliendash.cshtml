
@{
    ViewBag.Title = "cliendash";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Cliente - MotorLink</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link href='@Url.Content("~/Content/styles.css")' rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="dashboard-container">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h2>motorlink</h2>
            </div>
            <nav class="sidebar-nav" id="sidebarNav">
                <a href="#" class="nav-item active" onclick="loadSection('dashboard')">
                    <span>Dashboard</span>
                </a>
                <a href="#" class="nav-item" onclick="loadSection('appointments')">
                    <span>Mis Citas</span>
                </a>
                <a href="#" class="nav-item" onclick="loadSection('orders')">
                    <span>Mis Órdenes</span>
                </a>
                <a href="#" class="nav-item" onclick="loadSection('payments')">
                    <span>Pagos</span>
                </a>
                <a href="#" class="nav-item" onclick="loadSection('vehicles')">
                    <span>Mis Vehículos</span>
                </a>
                <a href="#" class="nav-item" onclick="loadSection('messages')">
                    <span>Mensajes</span>
                </a>
                <hr>
                <a href="#" class="nav-item" onclick="loadSection('profile')">
                    <span>Mi Perfil</span>
                </a>
                <a href="login.html" class="nav-item" onclick="handleLogout()">
                    <span>Cerrar Sesión</span>
                </a>
            </nav>
        </aside>

        <!-- MAIN -->
        <main class="main-content">
            <!-- TOP NAV -->
            <header class="top-nav">
                <div class="search-bar">
                    <input type="text" placeholder="Buscar...">
                </div>
                <div class="nav-right">
                    <button class="icon-btn">🔔</button>
                    <button class="icon-btn">⚙️</button>
                    <div class="user-profile">
                        <img src="https://via.placeholder.com/40" alt="Usuario">
                        <span id="userName">Cliente</span>
                    </div>
                </div>
            </header>

            <div class="content-area" id="contentArea">
                <!-- Dashboard -->
                <section id="dashboard-section" class="section active">
                    <h1>Bienvenido a tu Dashboard</h1>

                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-number" id="totalAppointments">0</div>
                            <div class="stat-label">Citas Pendientes</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number" id="totalOrders">0</div>
                            <div class="stat-label">Órdenes Activas</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number" id="totalDue">$0</div>
                            <div class="stat-label">Monto Pendiente</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number" id="totalVehicles">0</div>
                            <div class="stat-label">Vehículos Registrados</div>
                        </div>
                    </div>

                    <div class="dashboard-grid">
                        <div class="dashboard-card">
                            <h3>Próximas Citas</h3>
                            <div id="upcomingAppointments" class="appointment-list">
                                <p class="empty-state">No hay citas próximas</p>
                            </div>
                            <a href="#" onclick="loadSection('appointments')" class="btn btn-secondary">Ver todas</a>
                        </div>

                        <div class="dashboard-card">
                            <h3>Órdenes Recientes</h3>
                            <div id="recentOrders" class="order-list">
                                <p class="empty-state">No hay órdenes</p>
                            </div>
                            <a href="#" onclick="loadSection('orders')" class="btn btn-secondary">Ver todas</a>
                        </div>
                    </div>
                </section>

                <!-- Citas -->
                <section id="appointments-section" class="section">
                    <div class="section-header">
                        <h1>Mis Citas</h1>
                        <button class="btn btn-primary" onclick="openAppointmentForm()">+ Nueva Cita</button>
                    </div>

                    <div id="appointmentsList" class="appointments-grid">
                        <p class="empty-state">No hay citas registradas</p>
                    </div>
                </section>

                <!-- Ordenes -->
                <section id="orders-section" class="section">
                    <h1>Mis Órdenes de Servicio</h1>

                    <div class="filter-bar">
                        <select id="filterStatus" onchange="filterOrders()">
                            <option value="">Todos los estados</option>
                            <option value="pendiente">Pendiente</option>
                            <option value="en-progreso">En Progreso</option>
                            <option value="completado">Completado</option>
                            <option value="cancelado">Cancelado</option>
                        </select>
                    </div>

                    <div id="ordersList" class="orders-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>ID Orden</th>
                                    <th>Vehículo</th>
                                    <th>Servicio</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th>Monto</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="ordersTableBody">
                                <tr><td colspan="7" class="empty-state">No hay órdenes</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- Pagos -->
                <section id="payments-section" class="section">
                    <div class="section-header">
                        <h1>Mis Pagos</h1>
                        <button class="btn btn-primary" onclick="openPaymentForm()">+ Realizar Pago</button>
                    </div>

                    <div id="paymentsList" class="payments-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>ID Pago</th>
                                    <th>Orden</th>
                                    <th>Monto</th>
                                    <th>Fecha</th>
                                    <th>Método</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody id="paymentsTableBody">
                                <tr><td colspan="6" class="empty-state">No hay pagos registrados</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- Vehiculos -->
                <section id="vehicles-section" class="section">
                    <div class="section-header">
                        <h1>Mis Vehículos</h1>
                        <button class="btn btn-primary" onclick="openVehicleForm()">+ Agregar Vehículo</button>
                    </div>

                    <div id="vehiclesList" class="vehicles-grid">
                        <p class="empty-state">No hay vehículos registrados</p>
                    </div>
                </section>

                <!-- Mensajes -->
                <section id="messages-section" class="section">
                    <h1>Mensajes</h1>

                    <div class="messages-container">
                        <div class="messages-list" id="messagesList">
                            <p class="empty-state">No hay mensajes</p>
                        </div>
                        <div class="message-thread" id="messageThread" style="display:none;">
                            <div id="messageContent"></div>
                            <div class="message-input">
                                <textarea id="messageText" placeholder="Escribe tu mensaje..."></textarea>
                                <button class="btn btn-primary" onclick="sendMessage()">Enviar</button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Prerfil-->
                <section id="profile-section" class="section">
                    <h1>Mi Perfil</h1>

                    <form id="profileForm" class="form-grid" onsubmit="updateProfile(event)">
                        <div class="form-group">
                            <label>Nombre Completo</label>
                            <input type="text" id="profileName" required>
                        </div>
                        <div class="form-group">
                            <label>Correo</label>
                            <input type="email" id="profileEmail" required>
                        </div>
                        <div class="form-group">
                            <label>Teléfono</label>
                            <input type="tel" id="profilePhone">
                        </div>
                        <div class="form-group">
                            <label>Dirección</label>
                            <input type="text" id="profileAddress">
                        </div>
                        <div class="form-group">
                            <label>Ciudad</label>
                            <input type="text" id="profileCity">
                        </div>
                        <div class="form-group">
                            <label>Contraseña Nueva (opcional)</label>
                            <input type="password" id="profilePassword">
                        </div>
                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    </form>
                </section>
            </div>
        </main>
    </div>

    <!-- MODALS -->
    <div id="appointmentModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('appointmentModal')">&times;</span>
            <h2>Agendar Nueva Cita</h2>
            <form onsubmit="saveAppointment(event)">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Vehículo</label>
                        <select id="appointmentVehicle" required>
                            <option>Selecciona un vehículo...</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Servicio</label>
                        <select id="appointmentService" required>
                            <option>Selecciona un servicio...</option>
                            <option value="mantenimiento">Mantenimiento General</option>
                            <option value="diagnostico">Diagnóstico de Motor</option>
                            <option value="frenos">Sistema de Frenos</option>
                            <option value="electrico">Sistema Eléctrico</option>
                            <option value="aceite">Cambio de Aceite</option>
                            <option value="alineacion">Alineación y Balanceo</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Fecha Deseada</label>
                        <input type="date" id="appointmentDate" required>
                    </div>
                    <div class="form-group">
                        <label>Hora Deseada</label>
                        <input type="time" id="appointmentTime" required>
                    </div>
                    <div class="form-group full">
                        <label>Descripción / Notas</label>
                        <textarea id="appointmentDescription" rows="4"></textarea>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Guardar Cita</button>
            </form>
        </div>
    </div>

    <script src="js/config.js"></script>
    <script src="js/auth.js"></script>
    <script src="js/app.js"></script>
    <script src="js/client-dashboard.js"></script>
</body>
</html>

